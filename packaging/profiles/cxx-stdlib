{% set repo_root = os.path.normpath(os.path.join(profile_dir, "..", "..")) %}
{% set sdk_16_5 = os.path.join(repo_root, "build", "sdks", "iPhoneOS16.5.sdk", "usr", "include", "c++", "v1") %}
{% set sdk_15_6 = os.path.join(repo_root, "build", "sdks", "iPhoneOS15.6.sdk", "usr", "include", "c++", "v1") %}

[conf]
{% if os.path.isdir(sdk_16_5) %}
user.itglegacy:cxx_stdlib_include={{ sdk_16_5 }}
{% elif os.path.isdir(sdk_15_6) %}
user.itglegacy:cxx_stdlib_include={{ sdk_15_6 }}
{% endif %}
