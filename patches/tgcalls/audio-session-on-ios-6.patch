@@ -34,7 +32,21 @@
 namespace {
 // Since webrtc::Mutex is not a reentrant lock and cannot check if the mutex is locked,
 // we need a separate variable to check that the mutex is locked in the RTCAudioSession.
-ABSL_CONST_INIT thread_local bool mutex_locked = false;
+pthread_key_t MutexLockedKey() {
+  static pthread_key_t key;
+  static pthread_once_t once = PTHREAD_ONCE_INIT;
+  pthread_once(&once, [] { pthread_key_create(&key, nullptr); });
+  return key;
+}
+
+bool MutexLocked() {
+  return pthread_getspecific(MutexLockedKey()) != nullptr;
+}
+
+void SetMutexLocked(bool locked) {
+  static char marker;
+  pthread_setspecific(MutexLockedKey(), locked ? &marker : nullptr);
+}
 }  // namespace
 
