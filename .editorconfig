# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Objective-C / C / C++ sources are tab-indented, matching the existing tree.
[*.{m,mm,h,c,cpp,cc}]
indent_style = tab

[Makefile]
indent_style = tab

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.sh]
indent_style = tab

# Markdown keeps trailing whitespace (two spaces = hard line break).
[*.md]
trim_trailing_whitespace = false
